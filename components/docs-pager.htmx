<div class="mt-16 flex items-center justify-between gap-4 border-t border-white/10 pt-6 text-sm">
  <div>
    {{#if prev-href}}
    <a href="{{prev-href}}" class="group flex items-center gap-2 text-zinc-400 transition hover:text-zinc-100">
      <span aria-hidden="true" class="transition group-hover:-translate-x-0.5">←</span>
      <span>
        <span class="block text-xs text-zinc-500">Back</span>
        {{prev-label}}
      </span>
    </a>
    {{/if}}
  </div>
  <div>
    {{#if next-href}}
    <a href="{{next-href}}" class="group flex items-center gap-2 text-right text-zinc-400 transition hover:text-zinc-100">
      <span>
        <span class="block text-xs text-zinc-500">Next</span>
        {{next-label}}
      </span>
      <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
    </a>
    {{/if}}
  </div>
</div>
